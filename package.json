{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:decision": "tsx --test src/core/decisionEngine.test.ts",
    "test:device-intents": "tsx --test src/utils/offlineEngine.device-intents.test.ts",
    "test": "npm run test:decision && npm run test:device-intents && npm run test:registry && npm run test:router && npm run test:memory && npm run test:memory-store && npm run test:memory-commands && npm run test:research-grounding && npm run test:jarvis-parity && npm run test:agent-kernel && npm run test:task-executor && npm run test:android-adapter && npm run test:android-adapter-integration && npm run test:offline-truthfulness && npm run test:security-truthfulness && npm run test:memory-privacy && npm run test:coding-agent-policy && npm run test:coding-lab-approval",
    "test:registry": "tsx --test src/core/toolsRegistry.test.ts",
    "test:router": "tsx --test src/core/brainRouter.test.ts",
    "test:memory": "tsx --test src/core/memoryPolicy.test.ts",
    "test:memory-store": "tsx --test src/core/memoryStore.test.ts",
    "test:memory-commands": "tsx --test src/core/memoryCommands.test.ts",
    "test:research-grounding": "tsx --test src/core/researchGrounding.test.ts",
    "test:jarvis-parity": "tsx --test src/core/jarvisParity.test.ts",
    "test:agent-kernel": "tsx --test src/core/agentKernel.test.ts",
    "test:task-executor": "tsx --test src/core/taskExecutor.test.ts",
    "test:android-adapter": "tsx --test src/core/androidDeviceAdapter.test.ts",
    "test:android-adapter-integration": "tsx --test src/core/androidDeviceAdapter.integration.test.ts",
    "test:offline-truthfulness": "tsx --test src/utils/offlineEngine.truthfulness.test.ts",
    "test:security-truthfulness": "tsx --test src/utils/security.truthfulness.test.ts",
    "test:memory-privacy": "tsx --test src/utils/memoryManager.privacy.test.ts",
    "test:coding-lab-approval": "tsx --test src/core/codingLabApproval.test.ts && tsx --test src/core/codingLabApproval.multifile.test.ts",
    "test:coding-agent-policy": "tsx --test src/core/codingAgentPolicy.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
